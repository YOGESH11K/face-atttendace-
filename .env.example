# ---------------------------------------------------------------------------
# Face Attendance System - environment configuration
# Copy to `.env` and adjust. NEVER commit your real .env file.
# ---------------------------------------------------------------------------

# Secret key used to sign session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Database URL. SQLite by default; use Postgres in production:
#   sqlite:///database.db
#   postgresql://user:password@host:5432/attendance
DATABASE_URL=sqlite:///database.db

# Directory for uploaded enrollment photos (relative to project root).
DATA_DIR=data

# Maximum photos allowed per student (recommend 3-8).
MAX_PHOTOS_PER_STUDENT=8

# ---- Security / sessions ----
# Set to true when serving over HTTPS.
SESSION_COOKIE_SECURE=true
# Lax (default), Strict, or None. Use None only with HTTPS when a separate
# frontend domain calls this API cross-origin.
SESSION_COOKIE_SAMESITE=Lax
# How long a login session lasts (days).
SESSION_DAYS=7
# CSRF token lifetime in seconds (8 hours).
WTF_CSRF_TIME_LIMIT=28800

# ---- Cross-origin SPA frontend ----
# Comma-separated origins allowed to call the API with credentials.
# Example: https://empirerecorgination.vercel.app
CORS_ALLOWED_ORIGINS=

# ---- Account policy ----
# Disable self-service registration for private school deployments.
ALLOW_REGISTRATION=true
# Comma-separated usernames auto-promoted to admin on registration/login.
ADMIN_USERNAMES=

# ---- Rate limiting ----
# Use a shared Redis for multi-worker deployments; memory:// for single worker.
RATELIMIT_STORAGE_URI=memory://

# ---- Logging ----
LOG_LEVEL=INFO

# ---- Recognition tuning ----
FACE_TOLERANCE=0.5
CONSISTENCY_FRAMES=3
CONSISTENCY_WINDOW_SECONDS=6
MIN_FACE_SIZE=110
MIN_BLUR_VARIANCE=40.0
MAX_IMAGE_DIMENSION=1600
